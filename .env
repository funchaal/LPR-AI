# =============================================================================
# ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env)
# =============================================================================
# Este arquivo centraliza as configurações da aplicação. Modifique os valores
# conforme necessário para o seu ambiente de execução.
# Convenção: Use 1 para VERDADEIRO (true) e 0 para FALSO (false).
# =============================================================================

# -----------------------------------------------------------------------------
# SEÇÃO 1: CONFIGURAÇÕES GERAIS E DE DEBUG
# -----------------------------------------------------------------------------

# (Opcional) Caminho para o arquivo de configuração JSON principal.
CONFIG_FILE=config.json

# Ativa o modo de debug para logs mais detalhados.
# 1=Ativado, 0=Desativado
DEBUG=0

# Exibe a janela de captura de vídeo em tempo real.
# 1=Exibir, 0=Não exibir
SHOW_CAPTURES=1

# Ativa o cálculo e log de FPS (frames por segundo).
# 1=Ativado, 0=Desativado
CALCULATE_FPS=1

# Limiar (em segundos) para registrar o FPS médio no log.
FPS_LOG_LIMIAR=5

# -----------------------------------------------------------------------------
# SEÇÃO 2: DISPOSITIVOS DE INFERÊNCIA (IA)
# -----------------------------------------------------------------------------
# Especifique em qual dispositivo os modelos de IA devem rodar.
# Opções: 'cpu', 'gpu:0', 'gpu:1', etc.

# Dispositivo para o modelo de DETECÇÃO de placas (YOLO).
PLATE_DETECTION_DEVICE=gpu:0

# Dispositivo para os modelos de OCR (reconhecimento de caracteres).
OCR_DEVICE=gpu:0

# -----------------------------------------------------------------------------
# SEÇÃO 3: CAMINHOS DE ARQUIVOS E MODELOS
# -----------------------------------------------------------------------------

# --- Modelos de Detecção e OCR ---
# Caminho para o modelo de detecção de placas (.pt).
PLATE_DETECTION_MODEL=app/models/plate/pytorch/best.pt

# Caminho para o modelo de DETECÇÃO de texto do PaddleOCR.
PADDLE_OCR_DET_MODEL=app/models/ocr/det/PP-OCRv3_mobile_det_infer/

# Caminho para o modelo de RECONHECIMENTO de texto do PaddleOCR.
PADDLE_OCR_REC_MODEL=app/models/ocr/rec/PP-OCRv5_server_rec/

# --- Arquivos de Configuração do OCR ---
# Caminho para o arquivo de dicionário de caracteres usado pelo OCR.
OCR_CHAR_DICT_FILE=app/models/dicts/ppocrv5_dict.txt

# Caminho para o JSON com regras de correção de caracteres (ex: "O" -> "0").
CHAR_CORRECTIONS_FILE=char_corrections.json

# -----------------------------------------------------------------------------
# SEÇÃO 4: CONFIGURAÇÕES DE PROCESSAMENTO E LÓGICA
# -----------------------------------------------------------------------------

# --- Configurações do OCR e Pós-processamento ---
# Define se o estágio de DETECÇÃO de texto do OCR deve ser usado.
# Não muito útil, pois o modelo principal já fornece um recorte preciso da placa.
# 1=Usar, 0=Não usar
USE_OCR_DETECTION=0

# Margem (em pixels) a ser adicionada ao redor da placa detectada antes do OCR (centraliza mais o texto para o OCR).
CROP_MARGIN=5

# Formatos de placa aceitos (L=Letra, N=Número), separados por vírgula.
READING_FORMATS=LLLNLNN,LLLNNNN

# (Opcional) Expressão regular para uma filtragem rápida das leituras possíveis.
READINGS_FILTER_REGEX=^(?=(?:.*[A-Za-z]){3,})(?=(?:.*\d){3,}).{5,9}$

# --- Configurações de Rastreamento e Estabilidade ---
# Máxima diferença (em pixels) entre coordenadas de detecções em frames consecutivos
# para considerá-las como sendo o um frame estacionário (sem movimento da placa).
STABILITY_MAX_COORDINATE_DIFFERENCE=5

# Número de frames que uma placa deve permanecer estável para ser considerada estacionária.
STATIONARY_FRAME_THRESHOLD=5

# Número máximo de frames sem detecção para considerar que o veículo saiu do frame.
MAX_NO_FRAME_COUNT=20

# Tenta continuamente o envio de placas ao servidor durante as leituras se ativado.
# Se desativado, apenas será enviado ao servidor quando o veículo sair do frame.
# 1=Ativado, 0=Desativado
USE_CONTINUOUS_TRIES=1

# -----------------------------------------------------------------------------
# SEÇÃO 5: ARMAZENAMENTO, LOGS E BANCO DE DADOS
# -----------------------------------------------------------------------------

# Diretório para salvar os arquivos de log.
LOGS_SAVE_DIR=log/

# Número de dias para manter os arquivos de log antes de excluí-los.
LOGS_SAVE_DAYS=30

# Caminho para o arquivo do banco de dados SQLite onde os registros são salvos.
DB_CONNECTION=db/captures.db

# Diretório para salvar as imagens das placas capturadas.
CAPTURES_SAVE_DIR=captures/

# Salva imagens de detecções "suspeitas" (baixa confiança, detecções que podem ser ruído, etc.) para análise.
# 1=Salvar, 0=Não salvar
SAVE_SUSPECT_DETECTIONS=1

# Diretório para salvar as imagens de detecções suspeitas.
SUSPECT_DETECTIONS_SAVE_DIR=suspect_detections/

# -----------------------------------------------------------------------------
# SEÇÃO 6: INTEGRAÇÃO COM API EXTERNA (OPCIONAL)
# -----------------------------------------------------------------------------
# Deixe em branco se não for usar.

# Endpoint da API para enviar os dados das placas lidas.
API_ENDPOINT=

# Usuário para autenticação na API.
API_USER=

# Senha para autenticação na API.
API_PASSWORD=

# (Opcional) Endpoint para registrar o fechamento/finalização de um evento.
CLOSE_API_ENDPOINT=
