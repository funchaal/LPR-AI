# Seção 1: Configurações Gerais e de Debug
INSTANCE_ID=OBJECT01
CONFIG_FILE=config.json
DEBUG=0
SHOW_CAPTURES=0
CALCULATE_FPS=1
FPS_LOG_LIMIAR=5

# Seção 2: Dispositivos de Inferência (IA)
PLATE_DETECTION_DEVICE=gpu
OCR_DEVICE=gpu

# Seção 3: Caminhos de Arquivos e Modelos (Internos da Imagem)
PLATE_DETECTION_MODEL=app/models/plate/pytorch/best.pt
OCR_DET_MODEL=app/models/ocr/det/PP-OCRv3_mobile_det_infer/
OCR_REC_MODEL=app/models/ocr/rec/PP-OCRv5_server_rec/
OCR_CHAR_DICT_FILE=app/models/dicts/ppocrv5_dict.txt
CHAR_CORRECTIONS_FILE=char_corrections.json

# Seção 4: Configurações de Processamento e Lógica do Algoritmo
USE_OCR_DETECTION=0
MIN_PLATE_DETECTION_HEIGHT=16
MIN_PLATE_DETECTION_WIDTH=10
OCR_TARGET_HEIGHT=48
OCR_TARGET_WIDTH=160
CROP_MARGIN=5
READING_FORMATS=LLLNLNN,LLLNNNN
READINGS_FILTER_REGEX=^(?=(?:.*[A-Za-z]){1,})(?=(?:.*\d){1,}).{5,9}$
STABILITY_MAX_COORDINATE_DIFFERENCE=5
STATIONARY_FRAME_THRESHOLD=5
MAX_NO_FRAME_COUNT=20
USE_CONTINUOUS_TRIES=1

# Seção 5: Armazenamento, Logs e Banco de Dados (Apontando para o Volume)
LOGS_SAVE_DIR=data/log/
LOGS_SAVE_DAYS=30
DB_CONNECTION=data/db/captures.db
CAPTURES_SAVE_DIR=data/captures/
SAVE_SUSPECT_DETECTIONS=1
SUSPECT_DETECTIONS_SAVE_DIR=data/suspect_detections/

# Seção 6: Integração com API (Opcional)
API_ENDPOINT=
API_USER=
API_PASSWORD=
CLOSE_API_ENDPOINT=