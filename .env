# .env
 
# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DO AMBIENTE DE EXECUÇÃO
# -----------------------------------------------------------------------------
 
SHOW_CAPTURES=1
CALCULATE_FPS=True
CONFIG_FILE=config.json
LOGS_SAVE_DIR=log/
LOGS_SAVE_DAYS=30

# --- Devices ---
PLATE_DETECTION_DEVICE=gpu:1
OCR_DEVICE=cpu
 
# --- Modelos ---
PLATE_DETECTION_MODEL=app/models/plate/pytorch/best.pt

PADDLE_OCR_DET_MODEL=app/models/ocr/paddlepaddle/det/PP-OCRv5_server_det/
PADDLE_OCR_REC_MODEL=app/models/ocr/paddlepaddle/rec/PP-OCRv5_server_rec/
 
# --- Arquivos de Configuração do OCR ---
OCR_CHAR_DICT_FILE=app/models/dicts/ppocrv5_dict.txt
CHAR_CORRECTIONS_FILE=char_corrections.json
 
# --- Configurações de Captura e Salvamento ---
CAPTURES_SAVE_DIR=captures/
DB_CONNECTION=db/captures.db
SAVE_SUSPECT_DETECTIONS=1
SUSPECT_DETECTIONS_SAVE_DIR=suspect_detections/
 
# --- Configurações do OCR ---
USE_OCR_DETECTION=0
USE_OCR_HPI=1
USE_OCR_TENSORRT=1
CROP_MARGIN=5
STABILITY_MAX_COORDINATE_DIFFERENCE=5
STATIONARY_FRAME_THRESHOLD=5
MAX_NO_FRAME_COUNT=10
 
# --- Outras Configurações ---
USE_CONTINUOUS_TRIES=0
READING_FORMATS=LLLNLNN,LLLNNNN
READINGS_FILTER_REGEX=^(?=(?:.*[A-Za-z]){1,})(?=(?:.*\d){1,}).{5,9}$
API_ENDPOINT=
API_USER=
API_PASSWORD=