# .env
 
# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DO AMBIENTE DE EXECUÇÃO
# -----------------------------------------------------------------------------
# OCR_BACKEND: Escolha o motor de inferência para OCR.
# Opções: 'paddle', 'openvino'.
#   - 'paddle': Usa o backend padrão do PaddlePaddle. Pode rodar em CPU ou GPU.
#   - 'openvino': Usa o backend otimizado da Intel. Roda apenas em CPU.
OCR_BACKEND=paddle
 
# COMPUTE_DEVICE: Define o dispositivo de computação.
# Opções: 'cpu', 'cuda'.
#   - Se 'cuda' for escolhido, tanto o YOLO quanto o PaddleOCR (se for o backend) usarão a GPU NVIDIA.
#   - Se OCR_BACKEND for 'openvino', esta variável será ignorada para o OCR (que usará CPU),
#     mas ainda será aplicada ao modelo YOLO.
COMPUTE_DEVICE=cuda
# -----------------------------------------------------------------------------
 
SHOW_CAPTURES=1
CALCULATE_FPS=True
CONFIG_FILE=config.json
LOGS_SAVE_DIR=log/
 
# --- Modelos ---
BASE_PLATE_MODEL=app/models/plate/pytorch/fine_tuned_plate_detector_3.pt
OPENVINO_OCR_DET_MODEL=app/models/ocr/openvino/det/en_PP-OCRv3_det_infer/en_PP-OCRv3_det_infer.xml
OPENVINO_OCR_REC_MODEL=app/models/ocr/openvino/rec/en_PP-OCRv4_rec_infer_finetuned/en_PP-OCRv4_rec_infer_finetuned.xml
PADDLE_OCR_DET_MODEL=app/models/ocr/paddlepaddle/det/en/en_PP-OCRv3_det_infer/
PADDLE_OCR_REC_MODEL=app/models/ocr/paddlepaddle/rec/en/en_PP-OCRv4_rec_infer/
OCR_CLASSIFICATION_MODEL=app/models/ocr/paddlepaddle/cls/ch_ppocr_mobile_v2.0_cls_infer/
 
# --- Arquivos de Configuração do OCR ---
OCR_CHAR_DICT_FILE=app/ocr_files/ppocr_keys_v1.txt
CHAR_CORRECTIONS_FILE=app/ocr_files/char_corrections.json
 
# --- Configurações de Captura e Salvamento ---
CAPTURES_SAVE_DIR=captures/
DB_CONNECTION=db/captures.db
SAVE_SUSPECT_DETECTIONS=1
SUSPECT_DETECTIONS_SAVE_DIR=suspect_detections/
 
# --- Configurações do OCR ---
USE_OCR_DETECTION=0
USE_OCR_ANGLE_CLS=0
CROP_MARGIN=5
 
# --- Outras Configurações ---
USE_CONTINUOUS_TRIES=0
READING_FORMATS=LLLNLNN,LLLNNNN
API_ENDPOINT=